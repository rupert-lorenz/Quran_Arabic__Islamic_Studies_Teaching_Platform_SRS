# Copy secrets into a gitignored file:
#   .env.local                  local development
#   .env.staging.local          staging host
#   .env.production.local       production host
#
# Load order (first existing value wins):
#   process environment
#   .env.<APP_ENV>.local
#   .env.local                  development only
#   .env.<APP_ENV>
#   .env
#
# APP_ENV: development | staging | production
# NODE_ENV stays development for `pnpm dev` and production for `pnpm start`.

APP_ENV=development
APP_NAME=Al Haramain Schools
APP_URL=http://localhost:3000
LOG_LEVEL=debug
DB_POOL_SIZE=10

# Required. Do not commit real credentials.
DATABASE_URL=postgresql://education_platform:change-me@127.0.0.1:5432/education_platform
REDIS_URL=redis://127.0.0.1:6379

# Local PostgreSQL 16 superuser password. Used only by `pnpm db:setup`.
POSTGRES_PASSWORD=

# Required in staging and production (32+ characters). Optional in development.
SESSION_SECRET=

# Signed-in session lifetime. Defaults: 7 days in development/staging, 14 in production.
# SESSION_TTL_DAYS=7

# Optional overrides. Defaults come from the APP_ENV profile.
# COOKIE_SECURE=true
# ALLOW_DESTRUCTIVE_DB=false
# TRUST_PROXY=false
# CORS_ORIGINS=https://app.example.com

# Integration secrets stay on the server. Leave unset until a vendor is chosen.
# PAYMENTS_SECRET_KEY=
# PAYMENTS_WEBHOOK_SECRET=
# PAYOUTS_SECRET_KEY=
# PAYOUTS_WEBHOOK_SECRET=
# CLASSROOM_API_KEY=
# CLASSROOM_API_SECRET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# EMAIL_API_KEY=
# AI_API_KEY=
