# Copy to .env.production.local on the production host. Do not commit secrets.
# Start with: pnpm start:production
# Prefer setting these as host environment variables instead of files.

APP_ENV=production
APP_NAME=Al Haramain Schools
APP_URL=https://www.example.com
LOG_LEVEL=warn
DB_POOL_SIZE=20
COOKIE_SECURE=true
ALLOW_DESTRUCTIVE_DB=false

DATABASE_URL=postgresql://education_platform:change-me@prod-db.example.com:5432/education_platform_production
REDIS_URL=redis://prod-redis.example.com:6379
SESSION_SECRET=replace-with-a-32-character-or-longer-secret
