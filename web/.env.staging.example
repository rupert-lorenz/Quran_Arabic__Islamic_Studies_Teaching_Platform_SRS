# Copy to .env.staging.local on the staging host. Do not commit secrets.
# Start with: pnpm start:staging

APP_ENV=staging
APP_NAME=Al Haramain Schools
APP_URL=https://staging.example.com
LOG_LEVEL=info
DB_POOL_SIZE=15
COOKIE_SECURE=true

DATABASE_URL=postgresql://education_platform:change-me@staging-db.example.com:5432/education_platform_staging
REDIS_URL=redis://staging-redis.example.com:6379
SESSION_SECRET=replace-with-a-32-character-or-longer-secret
